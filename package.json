{
  "name": "srcdev-nuxt-components",
  "type": "module",
  "version": "9.9.8",
  "main": "nuxt.config.ts",
  "types": "types.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "clean": "rm -rf .nuxt && rm -rf .output",
    "cleanall": "rm -rf node_modules && rm -rf .nuxt && rm -rf .output && rm package-lock.json",
    "reinstall": "rm -rf node_modules && npm install",
    "cleaninstall": "npm run clean && npm run reinstall",
    "generate:ramps": "node scripts/generate-ramps.mjs",
    "check:ramps": "node scripts/check-ramps.mjs",
    "dev": "npm run generate:ramps && SRCDEV_STANDALONE=true storybook dev -p 6006",
    "build": "npm run generate:ramps && SRCDEV_STANDALONE=true nuxt build",
    "generate": "npm run generate:ramps && SRCDEV_STANDALONE=true nuxt generate",
    "preview": "SRCDEV_STANDALONE=true nuxt preview",
    "lint": "eslint .",
    "prepare": "SRCDEV_STANDALONE=true nuxt prepare",
    "release": "release-it",
    "test": "SRCDEV_STANDALONE=true vitest",
    "test:run": "SRCDEV_STANDALONE=true vitest --run",
    "test:ui": "SRCDEV_STANDALONE=true vitest --ui",
    "test:update": "SRCDEV_STANDALONE=true vitest --update",
    "storybook": "SRCDEV_STANDALONE=true storybook dev -p 6006",
    "storybook:build": "SRCDEV_STANDALONE=true storybook build",
    "storybook:serve": "npm run storybook:build && npx http-server storybook-static --port 6006",
    "storybook:cache:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite",
    "playwright": "SRCDEV_STANDALONE=true npx playwright test",
    "playwright:update": "SRCDEV_STANDALONE=true npx playwright test --update-snapshots=changed"
  },
  "files": [
    ".claude/skills/",
    ".claude/rules/consumer/",
    ".vscode/",
    "app/",
    "modules/",
    "scripts/",
    "ramps.config.mjs",
    "nuxt.config.ts",
    "types.d.ts",
    "!**/tests/",
    "!**/stories/",
    "!**/playwright/"
  ],
  "peerDependencies": {
    "@iconify-json/akar-icons": "*",
    "@iconify-json/bi": "*",
    "@iconify-json/bitcoin-icons": "*",
    "@iconify-json/gravity-ui": "*",
    "@iconify-json/ic": "*",
    "@iconify-json/logos": "*",
    "@iconify-json/lucide": "*",
    "@iconify-json/material-symbols": "*",
    "@iconify-json/mdi": "*",
    "@iconify-json/radix-icons": "*"
  },
  "peerDependenciesMeta": {
    "@iconify-json/akar-icons": {
      "optional": true
    },
    "@iconify-json/bi": {
      "optional": true
    },
    "@iconify-json/bitcoin-icons": {
      "optional": true
    },
    "@iconify-json/gravity-ui": {
      "optional": true
    },
    "@iconify-json/ic": {
      "optional": true
    },
    "@iconify-json/logos": {
      "optional": true
    },
    "@iconify-json/lucide": {
      "optional": true
    },
    "@iconify-json/material-symbols": {
      "optional": true
    },
    "@iconify-json/mdi": {
      "optional": true
    },
    "@iconify-json/radix-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@iconify-json/akar-icons": "1.2.7",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/bitcoin-icons": "1.2.5",
    "@iconify-json/gravity-ui": "1.2.15",
    "@iconify-json/ic": "*",
    "@iconify-json/logos": "1.2.19",
    "@iconify-json/lucide": "1.2.153",
    "@iconify-json/material-symbols": "1.2.98",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/radix-icons": "*",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/schema": "4.6.4",
    "@nuxt/test-utils": "4.4.0",
    "@nuxtjs/storybook": "10.0.3",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/builder-vite": "10.6.7",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-storybook": "10.6.7",
    "happy-dom": "21.0.4",
    "nuxt-qrcode": "0.4.10",
