{
  "SRCDEV InputRange Basic": {
    "description": "Basic InputRange native range input (no label/error wrapper)",
    "scope": "vue,html",
    "body": [
      "<InputRange",
      "  id=\"$1fieldId\"",
      "  name=\"$2fieldName\"",
      "  v-model=\"$3fieldValue\"",
      "  :min=\"$40\"",
      "  :max=\"$5100\"",
      "  :step=\"$61\"",
      "/>"
    ]
  },
  "SRCDEV InputRange With Markers": {
    "description": "InputRange with custom tick-mark markers overlaid on the track",
    "scope": "vue,html",
    "body": [
      "<InputRange",
      "  id=\"$1fieldId\"",
      "  name=\"$2fieldName\"",
      "  v-model=\"$3fieldValue\"",
      "  :min=\"$40\"",
      "  :max=\"$52\"",
      "  :step=\"$61\"",
      ">",
      "  <template #markers>",
      "    <div class=\"input-range-markers\">",
      "      <div class=\"input-range-marker\"><span class=\"input-range-marker-icon\">$7\\ud83d\\ude00</span></div>",
      "      <div class=\"input-range-marker\"><span class=\"input-range-marker-icon\">$8\\ud83d\\ude10</span></div>",
      "      <div class=\"input-range-marker\"><span class=\"input-range-marker-icon\">$9\\ud83d\\ude1e</span></div>",
      "    </div>",
      "  </template>",
      "</InputRange>"
    ]
  },
  "SRCDEV InputRange With Datalist": {
    "description": "InputRange with a datalist; the slot passes the generated datalistId",
    "scope": "vue,html",
    "body": [
      "<InputRange",
      "  id=\"$1fieldId\"",
      "  name=\"$2fieldName\"",
      "  v-model=\"$3fieldValue\"",
      "  :min=\"${4:0}\"",
      "  :max=\"${5:100}\"",
      ">",
      "  <template #datalist=\"{ datalistId }\">",
      "    <datalist :id=\"datalistId\" class=\"input-range-datalist\">",
      "      <option value=\"${4:0}\" label=\"${6:Low}\"></option>",
      "      <option value=\"${5:100}\" label=\"${7:High}\"></option>",
      "    </datalist>",
      "  </template>",
      "</InputRange>"
    ]
  },
  "SRCDEV InputRangeField Basic": {
    "description": "InputRangeField: labelled range slider with error/description support",
    "scope": "vue,html",
    "body": [
      "<InputRangeField",
      "  v-model=\"$1fieldValue\"",
      "  name=\"$2fieldName\"",
      "  label=\"$3Field label\"",
      "  :min=\"$40\"",
      "  :max=\"$5100\"",
      "  :step=\"$61\"",
      "  :error-message=\"$7errors.fieldName\"",
      "  :field-has-error=\"!!$7errors.fieldName\"",
      "/>"
    ]
  },
  "SRCDEV InputRangeField With Step Buttons": {
    "description": "InputRangeField with step-down/step-up buttons wired into the left/right slots",
    "scope": "vue,html",
    "body": [
      "<InputRangeField",
      "  v-model=\"$1fieldValue\"",
      "  name=\"$2fieldName\"",
      "  label=\"$3Field label\"",
      "  :min=\"$40\"",
      "  :max=\"$5100\"",
      "  :step=\"$61\"",
      "  :error-message=\"$7errors.fieldName\"",
      "  :field-has-error=\"!!$7errors.fieldName\"",
      ">",
      "  <template #left>\\u2212</template>",
      "  <template #right>+</template>",
      "</InputRangeField>"
    ]
  },
  "SRCDEV InputRange CSS Override": {
    "description": "CSS override scaffold for InputRange tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  .input-range-wrapper {",
      "    --input-range-accent-colour: $2;",
      "    --input-range-marker-background-colour: $3;",
      "  }",
      "}"
    ]
  }
}
