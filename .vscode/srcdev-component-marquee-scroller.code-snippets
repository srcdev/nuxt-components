{
  "SRCDEV MarqueeScroller Basic": {
    "description": "MarqueeScroller — infinite horizontal logo/badge scroller with per-item slots",
    "scope": "vue,html",
    "body": [
      "<MarqueeScroller",
      "  :marquee-data=\"[",
      "    { id: 1, content: '${1:logo-a}' },",
      "    { id: 2, content: '${2:logo-b}' },",
      "  ]\"",
      "  :item-config=\"{ width: '${3:120px}', height: '${4:60px}', gap: '${5:24px}' }\"",
      "  :style-class-passthrough=\"[${6:}]\"",
      ">",
      "  <template #1>",
      "    $7",
      "  </template>",
      "  <template #2>",
      "    $8",
      "  </template>",
      "</MarqueeScroller>"
    ]
  },
  "SRCDEV MarqueeScroller With Controls": {
    "description": "MarqueeScroller with the visible pause/play control button (WCAG 2.2.2)",
    "scope": "vue,html",
    "body": [
      "<MarqueeScroller",
      "  :marquee-data=\"${1:items}\"",
      "  show-controls",
      "  aria-label=\"${2:Scrolling client logos}\"",
      ">",
      "  <template v-for=\"item in ${1:items}\" #[item.id] :key=\"item.id\">",
      "    $3",
      "  </template>",
      "</MarqueeScroller>"
    ]
  },
  "SRCDEV MarqueeScroller Custom Control Icon/Copy": {
    "description": "MarqueeScroller control button with custom icons and localised aria-labels",
    "scope": "vue,html",
    "body": [
      "<MarqueeScroller",
      "  :marquee-data=\"${1:items}\"",
      "  show-controls",
      "  play-icon=\"${2:mdi:play-circle}\"",
      "  pause-icon=\"${3:mdi:pause-circle}\"",
      "  play-label=\"${4:Play}\"",
      "  pause-label=\"${5:Pause}\"",
      ">",
      "  <template v-for=\"item in ${1:items}\" #[item.id] :key=\"item.id\">",
      "    $6",
      "  </template>",
      "</MarqueeScroller>"
    ]
  },
  "SRCDEV MarqueeScroller Custom Toggle Icon Slot": {
    "description": "MarqueeScroller with the toggle-icon slot fully replacing the control button's icon",
    "scope": "vue,html",
    "body": [
      "<MarqueeScroller :marquee-data=\"${1:items}\" show-controls>",
      "  <template #toggle-icon=\"{ isPaused }\">",
      "    $2",
      "  </template>",
      "</MarqueeScroller>"
    ]
  },
  "SRCDEV MarqueeScroller CSS Override": {
    "description": "CSS override scaffold for MarqueeScroller — scope to a page or section class",
    "scope": "css",
    "body": [
      ".${1:my-page} {",
      "  .marquee-scroller {",
      "    --marquee-scroller-fade-width: ${2:10%};",
      "    --marquee-scroller-focus-outline-width: ${3:2px};",
      "    --marquee-scroller-focus-outline-colour: ${4:var(--theme-ring)};",
      "    --marquee-scroller-focus-outline-offset: ${5:2px};",
      "    --marquee-scroller-item-border-colour: ${6:var(--slate-10)};",
      "    --marquee-scroller-item-border-width: ${7:1px};",
      "    --marquee-scroller-item-border-radius: ${8:4px};",
      "    --marquee-scroller-item-transition-duration: ${9:0.5s};",
      "    --marquee-scroller-group-hover-filter: ${10:grayscale(1)};",
      "    --marquee-scroller-item-hover-filter: ${11:grayscale(0)};",
      "    --marquee-scroller-control-offset: ${12:8px};",
      "    --marquee-scroller-control-background-colour: ${13:rgba(0, 0, 0, 0.7)};",
      "    --marquee-scroller-control-background-colour-hover: ${14:rgba(0, 0, 0, 0.9)};",
      "    --marquee-scroller-control-text-colour: ${15:white};",
      "    --marquee-scroller-control-border-radius: ${16:4px};",
      "    --marquee-scroller-control-border-width: ${17:1px};",
      "    --marquee-scroller-control-padding: ${18:8px};",
      "    --marquee-scroller-control-font-size: ${19:14px};",
      "    --marquee-scroller-control-transition-duration: ${20:0.2s};",
      "  }",
      "}"
    ]
  }
}
