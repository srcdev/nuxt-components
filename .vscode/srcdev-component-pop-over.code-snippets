{
  "SRCDEV PopOver Basic": {
    "description": "PopOver — generic anchor-positioned disclosure panel",
    "scope": "vue,html",
    "body": [
      "<PopOver>",
      "  <template #trigger>",
      "    <span>$1</span>",
      "  </template>",
      "  <template #content>",
      "    <p>$0</p>",
      "  </template>",
      "</PopOver>"
    ]
  },
  "SRCDEV PopOver Placement": {
    "description": "PopOver with an explicit placement",
    "scope": "vue,html",
    "body": [
      "<PopOver placement=\"${1|top,right,bottom,left|}\">",
      "  <template #trigger>",
      "    <span>$2</span>",
      "  </template>",
      "  <template #content>",
      "    <p>$0</p>",
      "  </template>",
      "</PopOver>"
    ]
  },
  "SRCDEV PopOver Icon Trigger": {
    "description": "PopOver with an icon-only trigger and localised labels",
    "scope": "vue,html",
    "body": [
      "<PopOver trigger-aria-label=\"${1:Show more}\" popover-aria-label=\"${2:More information}\">",
      "  <template #trigger>",
      "    <Icon name=\"${3:lucide:info}\" aria-hidden=\"true\" />",
      "  </template>",
      "  <template #content>",
      "    <p>$0</p>",
      "  </template>",
      "</PopOver>"
    ]
  },
  "SRCDEV PopOver Localised Close": {
    "description": "PopOver with a localised close label and a custom close icon",
    "scope": "vue,html",
    "body": [
      "<PopOver close-button-aria-label=\"${1:Close}\" close-icon=\"${2:lucide:x}\">",
      "  <template #trigger>",
      "    <span>$3</span>",
      "  </template>",
      "  <template #content>",
      "    <p>$0</p>",
      "  </template>",
      "</PopOver>"
    ]
  },
  "SRCDEV PopOver CSS Overrides": {
    "description": "Unlayered CSS override scaffold for PopOver public tokens",
    "scope": "css,vue",
    "body": [
      ".${1:my-section} {",
      "  --pop-over-width: ${2:30rem};",
      "  --pop-over-gap: ${3:1rem};",
      "  --pop-over-background-colour: ${4:var(--slate-00)};",
      "  --pop-over-text-colour: ${5:var(--slate-09)};",
      "  --pop-over-border-colour: ${6:var(--slate-02)};",
      "  --pop-over-content-padding: ${7:1.6rem};$0",
      "}"
    ]
  }
}
