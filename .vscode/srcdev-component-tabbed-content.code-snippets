{
  "SRCDEV TabbedContent Basic": {
    "description": "TabbedContent — horizontal tablist with indexed trigger/content slots",
    "scope": "vue,html",
    "body": [
      "<TabbedContent :item-count=\"${1:3}\" aria-label=\"${8:Product details}\">",
      "  <template #tab-0-trigger>${2:Overview}</template>",
      "  <template #tab-0-content>",
      "    $3",
      "  </template>",
      "  <template #tab-1-trigger>${4:Specs}</template>",
      "  <template #tab-1-content>",
      "    $5",
      "  </template>",
      "  <template #tab-2-trigger>${6:Reviews}</template>",
      "  <template #tab-2-content>",
      "    $7",
      "  </template>",
      "</TabbedContent>"
    ]
  },
  "SRCDEV TabbedContent Vertical": {
    "description": "TabbedContent with axis=\"y\" for a vertical tab column",
    "scope": "vue,html",
    "body": [
      "<TabbedContent axis=\"y\" :item-count=\"${1:3}\" aria-label=\"${2:Settings}\">",
      "  <template #tab-0-trigger>$3</template>",
      "  <template #tab-0-content>$4</template>",
      "</TabbedContent>"
    ]
  },
  "SRCDEV TabbedContent Indicators Off": {
    "description": "TabbedContent with the moving hover/active/underline decorators all disabled",
    "scope": "vue,html",
    "body": [
      "<TabbedContent",
      "  :item-count=\"${1:3}\"",
      "  :track-hover=\"false\"",
      "  :track-active=\"false\"",
      "  :track-indicator=\"false\"",
      ">",
      "  $2",
      "</TabbedContent>"
    ]
  },
