{
  "SRCDEV ProgressTracker": {
    "description": "ProgressTracker showing progress through steps (v-model is the 0-based current step)",
    "scope": "vue,html",
    "body": [
      "<ProgressTracker v-model=\"${1:currentStep}\" :steps=\"${2:steps}\" />"
    ]
  },
  "SRCDEV ProgressTracker Wizard": {
    "description": "ProgressTracker as a wizard: each step's form lives in its #step-{n} slot and drives the model",
    "scope": "vue,html",
    "body": [
      "<ProgressTracker v-model=\"${1:currentStep}\" :steps=\"${2:steps}\">",
      "  <template #step-0=\"{ headingId }\">",
      "    <form :aria-labelledby=\"headingId\" @submit.prevent=\"$1++\">",
      "      $3",
      "      <InputButton type=\"submit\" button-text=\"Continue\" />",
      "    </form>",
      "  </template>",
      "  <template #step-1=\"{ headingId }\">",
      "    <form :aria-labelledby=\"headingId\" @submit.prevent=\"$1 = $2.length\">",
      "      $4",
      "      <InputButton button-text=\"Back\" variant=\"secondary\" @click=\"$1--\" />",
      "      <InputButton type=\"submit\" button-text=\"Submit\" />",
      "    </form>",
      "  </template>",
      "</ProgressTracker>"
    ]
  },
  "SRCDEV ProgressTracker CSS Override": {
    "description": "CSS override scaffold for ProgressTracker tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  --progress-tracker-accent: $2;",
      "  --progress-tracker-track: $3;",
      "  --progress-tracker-card-surface: $4;",
      "  --progress-tracker-card-shadow: $5;",
      "  --progress-tracker-label-font-family: $6;",
      "  --progress-tracker-title-line-clamp: $7;",
      "  --progress-tracker-body-line-clamp: $8;",
      "}"
    ]
  }
}
