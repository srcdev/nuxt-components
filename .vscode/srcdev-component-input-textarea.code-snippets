{
  "SRCDEV InputTextarea Basic": {
    "description": "Basic InputTextarea native textarea (no label/error wrapper)",
    "scope": "vue,html",
    "body": [
      "<InputTextarea",
      "  id=\"$1fieldId\"",
      "  v-model=\"$2fieldValue\"",
      "  name=\"$3fieldName\"",
      "  placeholder=\"$4Placeholder text\"",
      "/>"
    ]
  },
  "SRCDEV InputTextareaField Basic": {
    "description": "InputTextareaField: labelled textarea with description and error support",
    "scope": "vue,html",
    "body": [
      "<InputTextareaField",
      "  v-model=\"$1fieldValue\"",
      "  name=\"$2fieldName\"",
      "  label=\"$3Field label\"",
      "  :maxlength=\"${4:1000}\"",
      "  :error-message=\"$5errors.fieldName\"",
      "  :field-has-error=\"!!$5errors.fieldName\"",
      ">",
      "  <template #descriptionText>$6</template>",
      "</InputTextareaField>"
    ]
  },
  "SRCDEV InputTextarea CSS Override": {
    "description": "CSS override scaffold for InputTextarea tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  --input-textarea-surface: $2;",
      "  --input-textarea-border: $3;",
      "  --input-textarea-max-height: ${4:20lh};",
      "",
      "  .input-textarea-field[data-invalid] {",
      "    $0",
      "  }",
      "}"
    ]
  }
}
