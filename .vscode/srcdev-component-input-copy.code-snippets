{
  "SRCDEV InputCopy Basic": {
    "description": "InputCopy: readonly input with a copy-to-clipboard button",
    "scope": "vue,html",
    "body": [
      "<InputCopy",
      "  :value=\"${1:licenseKey}\"",
      "  label=\"${2:License key}\"",
      "  description=\"${3:Copy this key to activate the component in your application.}\"",
      "  @copied=\"${4:handleCopied}\"",
      "/>"
    ]
  },
  "SRCDEV InputCopy Translated": {
    "description": "InputCopy with translated copy and accessible names",
    "scope": "vue,html",
    "body": [
      "<InputCopy",
      "  :value=\"${1:value}\"",
      "  :label=\"${2:t('account.key.label')}\"",
      "  :description=\"${3:t('account.key.description')}\"",
      "  :button-text=\"${4:t('common.copy')}\"",
      "  :copied-text=\"${5:t('common.copied')}\"",
      "  :button-aria-label=\"${6:t('account.key.copyAriaLabel')}\"",
      "/>"
    ]
  },
  "SRCDEV InputCopy Disabled": {
    "description": "InputCopy in disabled state",
    "scope": "vue,html",
    "body": [
      "<InputCopy",
      "  :value=\"${1:value}\"",
      "  label=\"${2:Label}\"",
      "  :is-disabled=\"${3:true}\"",
      "  button-text=\"${4:Unavailable}\"",
      "/>"
    ]
  },
  "SRCDEV InputCopy CSS Override": {
    "description": "CSS override scaffold for InputCopy tokens",
    "scope": "css",
    "body": [
      ".${1:account-page} .input-copy {",
      "  --input-copy-input-bg: ${2:var(--theme-input-surface)};",
      "  --input-copy-input-border: ${3:0.1rem solid var(--theme-border)};",
      "  --input-copy-button-bg: ${4:var(--theme-surface)};",
      "  --input-copy-button-bg-hover: ${5:var(--theme-surface-hover)};",
      "  --input-copy-button-text-color: ${6:var(--theme-on-surface)};",
      "  --input-copy-description-line-clamp: ${7:none};",
      "}"
    ]
  }
}
