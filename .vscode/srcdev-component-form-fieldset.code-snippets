{
  "SRCDEV FormFieldset Basic": {
    "description": "FormFieldset: fieldset + legend wrapper for a group of controls",
    "scope": "vue,html",
    "body": [
      "<FormFieldset",
      "  id=\"${1:fieldId}\"",
      "  name=\"${2:fieldName}\"",
      "  legend=\"${3:Legend}\"",
      "  group-role=\"${4|group,radiogroup|}\"",
      "  :field-has-error=\"!!${5:errors.fieldName}\"",
      ">",
      "  <template #content>",
      "    $0",
      "  </template>",
      "</FormFieldset>"
    ]
  },
  "SRCDEV FormFieldset CSS Override": {
    "description": "CSS override scaffold for FormFieldset tokens",
    "scope": "css",
    "body": [
      ".${1:my-page} {",
      "  .form-fieldset {",
      "    --form-fieldset-padding-block: ${2:0};",
      "    --form-fieldset-padding-inline: ${3:0};",
      "    --form-fieldset-border: ${4:0};",
      "    --form-fieldset-legend-color: ${5:inherit};",
      "    --form-fieldset-legend-font-size: ${6:var(--step-5)};",
      "    --form-fieldset-legend-font-weight: ${7:normal};",
      "    --form-fieldset-legend-margin-block: ${8:0.8rem};",
      "  }",
      "}"
    ]
  }
}
