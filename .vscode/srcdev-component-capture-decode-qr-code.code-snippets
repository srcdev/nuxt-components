{
  "SRCDEV CaptureQrCode": {
    "description": "CaptureQrCode live camera scanner with localisable copy",
    "scope": "vue,html",
    "body": [
      "<CaptureQrCode",
      "  camera-stopped-label=\"${1:Camera stopped}\"",
      "  reset-camera-label=\"${2:Reset camera}\"",
      "  :error-messages=\"{ NotAllowedError: '${3:Camera access was blocked.}', default: '${4:The camera could not be started.}' }\"",
      "/>"
    ]
  },
  "SRCDEV CaptureQrCode Custom Error": {
    "description": "CaptureQrCode with a custom, translated error block",
    "scope": "vue,html",
    "body": [
      "<CaptureQrCode>",
      "  <template #error=\"{ error, reset }\">",
      "    <p>{{ error === 'NotAllowedError' ? '$1' : '$2' }}</p>",
      "    <InputButton variant=\"secondary\" button-text=\"$3\" @click=\"reset\" />",
      "  </template>",
      "</CaptureQrCode>"
    ]
  },
  "SRCDEV DecodeQrCode": {
    "description": "DecodeQrCode image upload / drop decoder",
    "scope": "vue,html",
    "body": [
      "<DecodeQrCode",
      "  upload-label=\"${1:Upload a QR code image}\"",
      "  drop-label=\"${2:Or drop a QR code image here}\"",
      "  no-result-label=\"${3:No QR code was found in that image.}\"",
      "  read-error-label=\"${4:That file couldn't be read as an image.}\"",
      "/>"
    ]
  }
}
