{
  "SRCDEV FormField Basic": {
    "description": "FormField layout wrapper around a single form control",
    "scope": "vue,html",
    "body": [
      "<FormField width=\"${1|wide,medium,narrow|}\" :has-gutter=\"${2|false,true|}\" :field-has-error=\"!!${3:errors.fieldName}\">",
      "  $0",
      "</FormField>"
    ]
  },
  "SRCDEV FormField CSS Override": {
    "description": "CSS override scaffold for FormField tokens",
    "scope": "css",
    "body": [
      ".${1:my-page} {",
      "  .form-field {",
      "    --form-field-max-width-narrow: ${2:400px};",
      "    --form-field-gutter-width: ${3:1.6rem};",
      "    --form-field-margin-block: ${4:0 1.6rem};",
      "    --form-field-background-color: ${5:transparent};",
      "    --form-field-border-radius: ${6:0.4rem};",
      "  }",
      "}"
    ]
  }
}
