{
  "SRCDEV InputText Basic": {
    "description": "Basic InputText native input (no label/error wrapper)",
    "scope": "vue,html",
    "body": [
      "<InputText",
      "  id=\"$1fieldId\"",
      "  v-model=\"$2fieldValue\"",
      "  name=\"$3fieldName\"",
      "  type=\"$4text\"",
      "  placeholder=\"$5Enter value\"",
      "/>"
    ]
  },
  "SRCDEV InputText Date with min/max": {
    "description": "InputText date input constrained to a min/max range (e.g. no dates in the past)",
    "scope": "vue,html",
    "body": [
      "<InputText",
      "  id=\"$1appointment-date\"",
      "  v-model=\"$2appointmentDate\"",
      "  name=\"$3appointmentDate\"",
      "  type=\"date\"",
      "  :min=\"new Date().toISOString().split('T')[0]\"",
      "  max=\"$42027-12-31\"",
      "/>"
    ]
  },
  "SRCDEV InputTextField Basic": {
    "description": "InputTextField: labelled text field with description and error support",
    "scope": "vue,html",
    "body": [
      "<InputTextField",
      "  v-model=\"$1fieldValue\"",
      "  name=\"$2fieldName\"",
      "  type=\"${3|text,email,tel,url,date,number|}\"",
      "  label=\"$4Field label\"",
      "  autocomplete=\"$5\"",
      "  :error-message=\"$6errors.fieldName\"",
      "  :field-has-error=\"!!$6errors.fieldName\"",
      ">",
      "  <template #descriptionText>$7</template>",
      "</InputTextField>"
    ]
  },
  "SRCDEV InputTextField Date with min/max": {
    "description": "InputTextField date field constrained to a min/max range",
    "scope": "vue,html",
    "body": [
      "<InputTextField",
      "  v-model=\"$1appointmentDate\"",
      "  name=\"$2appointmentDate\"",
      "  type=\"date\"",
      "  label=\"$3Appointment date\"",
      "  :min=\"new Date().toISOString().split('T')[0]\"",
      "  max=\"$42027-12-31\"",
      "  :error-message=\"$5errors.appointmentDate\"",
      "  :field-has-error=\"!!$5errors.appointmentDate\"",
      "/>"
    ]
  },
  "SRCDEV InputPasswordField": {
    "description": "InputPasswordField with show/hide toggle",
    "scope": "vue,html",
    "body": [
      "<InputPasswordField",
      "  v-model=\"$1password\"",
      "  name=\"$2password\"",
      "  label=\"$3Password\"",
      "  autocomplete=\"${4|current-password,new-password|}\"",
      "  :error-message=\"$5errors.password\"",
      "  :field-has-error=\"!!$5errors.password\"",
      "  show-password-text=\"$6Show password\"",
      "  hide-password-text=\"$7Hide password\"",
      "/>"
    ]
  },
  "SRCDEV InputTextAsNumberField": {
    "description": "InputTextAsNumberField numeric stepper with min/max/step",
    "scope": "vue,html",
    "body": [
      "<InputTextAsNumberField",
      "  v-model=\"$1quantity\"",
      "  name=\"$2quantity\"",
      "  label=\"$3Quantity\"",
      "  :min=\"$41\"",
      "  :max=\"$599\"",
      "  :step=\"$61\"",
      "  :error-message=\"$7errors.quantity\"",
      "  :field-has-error=\"!!$7errors.quantity\"",
      ">",
      "  <template #left><Icon name=\"mdi:minus\" /></template>",
      "  <template #right><Icon name=\"mdi:plus\" /></template>",
      "</InputTextAsNumberField>"
    ]
  },
  "SRCDEV InputText CSS Override": {
    "description": "CSS override scaffold for InputText tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  --input-text-surface: $2;",
      "  --input-text-border: $3;",
      "  --input-text-border-focus: $4;",
      "  --input-text-color: $5;",
      "",
      "  .input-text-field[data-invalid] {",
      "    $0",
      "  }",
      "}"
    ]
  }
}
