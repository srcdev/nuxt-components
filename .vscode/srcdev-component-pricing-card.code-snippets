{
  "SRCDEV PricingCard Single": {
    "description": "Single PricingCard component with basic props",
    "scope": "vue,html",
    "body": [
      "<PricingCard",
      "  plan-name=\"$1Single Site\"",
      "  :price=\"$2199\"",
      "  currency-symbol=\"$3£\"",
      "  billing-period=\"$4one-time\"",
      "  description=\"$5Perfect for freelancers and solo practitioners.\"",
      "  :features=\"['$6Feature 1', '$7Feature 2', '$8Feature 3']\"",
      "  @select=\"$9handleSelect\"",
      "/>"
    ]
  },
  "SRCDEV PricingCard Highlighted": {
    "description": "PricingCard with 'Most Popular' highlight",
    "scope": "vue,html",
    "body": [
      "<PricingCard",
      "  plan-name=\"$1Agency\"",
      "  :price=\"$2499\"",
      "  billing-period=\"$3one-time\"",
      "  description=\"$4Best for growing teams.\"",
      "  is-highlighted",
      "  badge-text=\"$5Most Popular\"",
      "  :features=\"['$6Feature 1', '$7Feature 2', '$8Feature 3']\"",
      "  @select=\"$9handleSelect\"",
      "/>"
    ]
  },
  "SRCDEV PricingCard Grid": {
    "description": "Pricing comparison grid from a plans array",
    "scope": "vue,html",
    "body": [
      "<div class=\"$1pricing-grid\">",
      "  <PricingCard",
      "    v-for=\"plan in $2plans\"",
      "    :key=\"plan.id\"",
      "    :plan-name=\"plan.name\"",
      "    :price=\"plan.price\"",
      "    :description=\"plan.description\"",
      "    :features=\"plan.features\"",
      "    :is-highlighted=\"plan.id === '$3pro'\"",
      "    heading-tag=\"$4h2\"",
      "    @select=\"$5handleSelect\"",
      "  />",
      "</div>"
    ]
  },
  "SRCDEV PricingCard Custom Button": {
    "description": "PricingCard with custom button via #cta slot",
    "scope": "vue,html",
    "body": [
      "<PricingCard",
      "  plan-name=\"$1Premium\"",
      "  :price=\"$2799\"",
      "  :features=\"['$3Feature 1', '$4Feature 2']\"",
      "  @select=\"$5handleSelect\"",
      ">",
      "  <template #cta=\"{ ctaText, isDisabled, onSelect }\">",
      "    <InputButton",
      "      :button-text=\"ctaText\"",
      "      variant=\"$6secondary\"",
      "      :readonly=\"isDisabled\"",
      "      @click=\"onSelect\"",
      "    />",
      "  </template>",
      "</PricingCard>"
    ]
  },
  "SRCDEV PricingCard Ribbon": {
    "description": "PricingCard with a diagonal discount ribbon",
    "scope": "vue,html",
    "body": [
      "<PricingCard",
      "  plan-name=\"$1Annual\"",
      "  :price=\"$249\"",
      "  billing-period=\"$3per year\"",
      "  ribbon-text=\"$4EARLYBIRD50 · 50% off\"",
      "  :features=\"['$5Feature 1', '$6Feature 2']\"",
      "  @select=\"$7handleSelect\"",
      "/>"
    ]
  },
  "SRCDEV PricingCard CSS Override": {
    "description": "CSS override scaffold for PricingCard tokens",
    "scope": "css",
    "body": [
      ".$1pricing-page {",
      "  .pricing-card {",
      "    --pricing-card-background: $2;",
      "    --pricing-card-border-radius: $3;",
      "    --pricing-card-padding: $4;",
      "    --pricing-card-gap: $5;",
      "    --pricing-card-name-color: $6;",
      "    --pricing-card-description-line-clamp: $7;",
      "    --pricing-card-feature-icon-color: $8;",
      "    --pricing-card-ribbon-bg: $9;",
      "    --input-button-primary-surface: $10;",
      "",
      "    &.is-highlighted {",
      "      --pricing-card-highlight-border: $11;",
      "      --pricing-card-highlight-scale: $12;",
      "      --pricing-card-badge-bg: $13;",
      "    }",
      "  }",
      "}"
    ]
  }
}
