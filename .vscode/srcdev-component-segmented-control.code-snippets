{
  "SRCDEV SegmentedControl": {
    "description": "SegmentedControl: three-option radio pill with a sliding marker",
    "scope": "vue,html",
    "body": [
      "<SegmentedControl",
      "  v-model=\"${1:selected}\"",
      "  v-model:field-data=\"${2:options}\"",
      "  aria-label=\"${3:Choose an option}\"",
      "/>"
    ]
  },
  "SRCDEV SegmentedControl Options": {
    "description": "IFormMultipleOptions data for SegmentedControl (system/light/dark values get marker gradients)",
    "scope": "typescript,vue",
    "body": [
      "const ${1:options} = ref<IFormMultipleOptions>({",
      "  data: [",
      "    { id: \"${2:system}\", name: \"${3:scheme}\", value: \"${2:system}\", label: \"${4:System}\", icon: \"${5:material-symbols:night-sight-auto-sharp}\" },",
      "    { id: \"${6:light}\", name: \"${3:scheme}\", value: \"${6:light}\", label: \"${7:Light}\", icon: \"${8:radix-icons:sun}\" },",
      "    { id: \"${9:dark}\", name: \"${3:scheme}\", value: \"${9:dark}\", label: \"${10:Dark}\", icon: \"${11:radix-icons:moon}\" },",
      "  ],",
      "  total: 3,",
      "  skip: 0,",
      "  limit: 3,",
      "});"
    ]
  }
}
