{
  "SRCDEV SelectMenu Basic": {
    "description": "SelectMenu — v-model single-select popover listbox",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:selectedValue}\"",
      "  :options=\"${2:options}\"",
      "  label=\"${3:Choose an option}\"",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Icon Only": {
    "description": "SelectMenu — icon-only compact trigger (e.g. language switcher)",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:language}\"",
      "  :options=\"${2:languageOptions}\"",
      "  label=\"${3:Language}\"",
      "  :show-label=\"false\"",
      "  :show-chevron=\"false\"",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Category Filter": {
    "description": "SelectMenu — text + chevron category filter, no per-option icons",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:filterValue}\"",
      "  :options=\"${2:filterOptions}\"",
      "  label=\"${3:Choose a service}\"",
      "  :show-icon=\"false\"",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Underlined": {
    "description": "SelectMenu — text + chevron with an underlined trigger, matching InputSelect's underlined variant",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:filterValue}\"",
      "  :options=\"${2:filterOptions}\"",
      "  label=\"${3:Choose a service}\"",
      "  :show-icon=\"false\"",
      "  input-variant=\"underlined\"",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Multi-Select": {
    "description": "SelectMenu — checkbox-per-option multi-select, v-model is an array",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:selectedValues}\"",
      "  :options=\"${2:options}\"",
      "  label=\"${3:Services required}\"",
      "  :show-icon=\"false\"",
      "  multiple",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Filter Count": {
    "description": "SelectMenu — multi-select filter with a category icon and a selected-count badge",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:selectedValues}\"",
      "  :options=\"${2:options}\"",
      "  label=\"${3:Category}\"",
      "  multiple",
      "  trigger-icon=\"${4:lucide:list}\"",
      "  indicator=\"count\"",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Filter Status Dot": {
    "description": "SelectMenu — single-select filter with a category icon and an active-filter status dot, fixed width across selections",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:status}\"",
      "  :options=\"${2:statusOptions}\"",
      "  label=\"${3:Status}\"",
      "  trigger-icon=\"${4:lucide:circle-dot}\"",
      "  indicator=\"dot\"",
      "  reserve-label-width",
      "/>"
    ]
  },
  "SRCDEV SelectMenu Multi-Select Showing Selection": {
    "description": "SelectMenu — multi-select where the trigger updates to list checked options",
    "scope": "vue,html",
    "body": [
      "<SelectMenu",
      "  v-model=\"${1:selectedValues}\"",
      "  :options=\"${2:options}\"",
      "  label=\"${3:Services required}\"",
      "  :show-icon=\"false\"",
      "  multiple",
      "  show-selection-in-trigger",
      "/>"
    ]
  }
}
