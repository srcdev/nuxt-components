{
  "SRCDEV ToggleSwitch": {
    "description": "ToggleSwitch: bare switch (pair with a label for=\"toggle-switch-{id}\", or use ToggleSwitchField)",
    "scope": "vue,html",
    "body": [
      "<label for=\"toggle-switch-$1toggle-id\">$2Label</label>",
      "<ToggleSwitch",
      "  id=\"$1toggle-id\"",
      "  v-model=\"$3modelValue\"",
      "  name=\"$4toggleName\"",
      "/>"
    ]
  },
  "SRCDEV ToggleSwitchField": {
    "description": "ToggleSwitchField: labelled switch with description and error support",
    "scope": "vue,html",
    "body": [
      "<ToggleSwitchField",
      "  v-model=\"$1fieldValue\"",
      "  name=\"$2fieldName\"",
      "  label=\"$3Field label\"",
      "  layout=\"${4|stacked,inline|}\"",
      "  :error-message=\"$5errors.fieldName\"",
      "  :field-has-error=\"!!$5errors.fieldName\"",
      ">",
      "  <template #descriptionText>$6Help text</template>",
      "</ToggleSwitchField>"
    ]
  },
  "SRCDEV ToggleSwitch CSS Override": {
    "description": "CSS override scaffold for ToggleSwitch tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  --toggle-switch-surface: $2;",
      "  --toggle-switch-symbol-surface-on: $3;",
      "  --input-toggle-symbol-size: ${4:2.4rem};",
      "}"
    ]
  }
}
