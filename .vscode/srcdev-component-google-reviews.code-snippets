{
  "SRCDEV GoogleReviews Basic": {
    "description": "GoogleReviews fed by useGoogleReviews() (needs NUXT_GOOGLE_REVIEWS_API_KEY and NUXT_GOOGLE_REVIEWS_PLACE_ID)",
    "scope": "vue,html",
    "body": [
      "<GoogleReviews :data=\"${1:googleReviews}\" />"
    ]
  },
  "SRCDEV GoogleReviews Script": {
    "description": "Fetch Google reviews from the layer's server route",
    "scope": "typescript,javascript,vue",
    "body": [
      "const { data: ${1:googleReviews} } = await useGoogleReviews();"
    ]
  },
  "SRCDEV GoogleReviews With Heading": {
    "description": "GoogleReviews labelled by its own heading, optionally filtered",
    "scope": "vue,html",
    "body": [
      "<GoogleReviews :data=\"${1:googleReviews}\" :min-rating=\"${2:0}\">",
      "  <template #heading=\"{ headingId }\">",
      "    <h2 :id=\"headingId\">${3:What clients say}</h2>",
      "  </template>",
      "</GoogleReviews>"
    ]
  },
  "SRCDEV GoogleReviews Custom Card": {
    "description": "GoogleReviews with each card rendered through the card slot",
    "scope": "vue,html",
    "body": [
      "<GoogleReviews :data=\"${1:googleReviews}\">",
      "  <template #card=\"{ review }\">",
      "    <GoogleReviewCard :review=\"review\" :style-class-passthrough=\"['${2:my-review}']\" />",
      "  </template>",
      "</GoogleReviews>"
    ]
  },
