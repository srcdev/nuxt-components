{
  "SRCDEV InputSelect Basic": {
    "description": "Basic InputSelect native select (no label/error wrapper)",
    "scope": "vue,html",
    "body": [
      "<InputSelect",
      "  id=\"$1fieldId\"",
      "  v-model=\"$2fieldValue\"",
      "  v-model:field-data=\"$3fieldOptions\"",
      "  name=\"$4fieldName\"",
      "  placeholder=\"$5Choose an option\"",
      "/>"
    ]
  },
  "SRCDEV InputSelectField Basic": {
    "description": "InputSelectField: labelled select with description and error support",
    "scope": "vue,html",
    "body": [
      "<InputSelectField",
      "  v-model=\"$1fieldValue\"",
      "  v-model:field-data=\"$2fieldOptions\"",
      "  name=\"$3fieldName\"",
      "  label=\"$4Field label\"",
      "  placeholder=\"$5Choose an option\"",
      "  :error-message=\"$6errors.fieldName\"",
      "  :field-has-error=\"!!$6errors.fieldName\"",
      ">",
      "  <template #descriptionText>$7</template>",
      "</InputSelectField>"
    ]
  },
  "SRCDEV InputSelect CSS Override": {
    "description": "CSS override scaffold for InputSelect tokens",
    "scope": "css",
    "body": [
      ".$1my-page {",
      "  --input-select-surface: $2;",
      "  --input-select-text-color: $3;",
      "  --input-select-border: $4;",
      "  --input-select-border-focus: $5;",
      "",
      "  .input-select-field[data-invalid] {",
      "    $0",
      "  }",
      "}"
    ]
  }
}
