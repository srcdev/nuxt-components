// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InputButton > Snapshots > icon-only slot 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="primary" data-icon-only="" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text sr-only">Click me</span>
  <!--v-if--><span class="input-button-icon" data-slot="icon-only"><span data-testid="icon-only">⚡</span></span>
</button>"
`;

exports[`InputButton > Snapshots > pending state 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="primary" data-pending="" data-pending-effect="" class="input-button"><svg class="pending-effect-container" data-theme="default" aria-hidden="true" focusable="false">
    <rect pathLength="100" stroke-linecap="round" class="pending-effect-blur"></rect>
    <rect pathLength="100" stroke-linecap="round" class="pending-effect-line"></rect>
  </svg>
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > pill 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="primary" data-pill="" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > primary (default) 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="primary" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > readonly 1`] = `
"<button type="button" readonly="" aria-disabled="true" data-testid="input-button" data-theme="default" data-variant="primary" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > secondary variant 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="secondary" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > tertiary variant 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="tertiary" class="input-button">
  <!--v-if-->
  <!--v-if--><span class="input-button-text">Click me</span>
  <!--v-if-->
  <!--v-if-->
</button>"
`;

exports[`InputButton > Snapshots > with left and right slots 1`] = `
"<button type="button" data-testid="input-button" data-theme="default" data-variant="primary" class="input-button">
  <!--v-if--><span class="input-button-icon" data-slot="left"><span data-testid="left-icon">←</span></span><span class="input-button-text">Click me</span><span class="input-button-icon" data-slot="right"><span data-testid="right-icon">→</span></span>
  <!--v-if-->
</button>"
`;
