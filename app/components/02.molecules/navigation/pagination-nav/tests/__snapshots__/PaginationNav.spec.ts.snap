exports[`PaginationNav > renders correct HTML structure 1`] = `
"<nav class="pagination-nav" aria-label="Pagination" data-marker="none">
  <div class="pagination-nav-row">
    <!--v-if--><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" data-icon-only="" class="input-button pagination-nav-control" data-control="previous">
      <!--v-if-->
      <!--v-if--><span class="input-button-text sr-only">Previous page</span>
      <!--v-if--><span class="input-button-icon" data-slot="icon-only"><span class="iconify i-lucide:chevron-left pagination-nav-icon" aria-hidden="true"></span></span>
    </button>
    <div class="pagination-nav-pages" style="--_pagination-nav-count: 7;">
      <!--v-if-->
      <ul class="pagination-nav-list" role="list">
        <li class="pagination-nav-item"><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" class="input-button pagination-nav-page" data-control="page" aria-label="Page 1">
            <!--v-if-->
            <!--v-if--><span class="input-button-text">1</span>
            <!--v-if-->
            <!--v-if-->
          </button></li>
        <li class="pagination-nav-item" aria-hidden="true"><span class="pagination-nav-ellipsis">…</span></li>
        <li class="pagination-nav-item"><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" class="input-button pagination-nav-page" data-control="page" aria-label="Page 9">
            <!--v-if-->
            <!--v-if--><span class="input-button-text">9</span>
            <!--v-if-->
            <!--v-if-->
          </button></li>
        <li class="pagination-nav-item"><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" class="input-button pagination-nav-page" data-control="page" aria-label="Page 10" aria-current="page">
            <!--v-if-->
            <!--v-if--><span class="input-button-text">10</span>
            <!--v-if-->
            <!--v-if-->
          </button></li>
        <li class="pagination-nav-item"><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" class="input-button pagination-nav-page" data-control="page" aria-label="Page 11">
            <!--v-if-->
            <!--v-if--><span class="input-button-text">11</span>
            <!--v-if-->
            <!--v-if-->
          </button></li>
        <li class="pagination-nav-item" aria-hidden="true"><span class="pagination-nav-ellipsis">…</span></li>
        <li class="pagination-nav-item"><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" class="input-button pagination-nav-page" data-control="page" aria-label="Page 20">
            <!--v-if-->
            <!--v-if--><span class="input-button-text">20</span>
            <!--v-if-->
            <!--v-if-->
          </button></li>
      </ul>
    </div>
    <p class="pagination-nav-summary" aria-live="polite" aria-atomic="true">Page 10 of 20</p><button type="button" data-testid="input-button" data-theme="default" data-variant="inline" data-icon-only="" class="input-button pagination-nav-control" data-control="next">
      <!--v-if-->
      <!--v-if--><span class="input-button-text sr-only">Next page</span>
      <!--v-if--><span class="input-button-icon" data-slot="icon-only"><span class="iconify i-lucide:chevron-right pagination-nav-icon" aria-hidden="true"></span></span>
    </button>
    <!--v-if-->
  </div>
</nav>"
`;

exports[`PaginationNav > renders correct HTML structure in link mode with edges and a marker 1`] = `
"<nav class="pagination-nav" aria-label="Pagination" data-marker="underline">
  <div class="pagination-nav-row"><button type="button" readonly="" aria-disabled="true" data-testid="input-button" data-theme="default" data-variant="inline" data-icon-only="" class="input-button pagination-nav-control" data-control="first">
      <!--v-if-->
      <!--v-if--><span class="input-button-text sr-only">First page</span>
      <!--v-if--><span class="input-button-icon" data-slot="icon-only"><span class="iconify i-lucide:chevrons-left pagination-nav-icon" aria-hidden="true"></span></span>
    </button><button type="button" readonly="" aria-disabled="true" data-testid="input-button" data-theme="default" data-variant="inline" data-icon-only="" class="input-button pagination-nav-control" data-control="previous">
      <!--v-if-->
      <!--v-if--><span class="input-button-text sr-only">Previous page</span>
      <!--v-if--><span class="input-button-icon" data-slot="icon-only"><span class="iconify i-lucide:chevron-left pagination-nav-icon" aria-hidden="true"></span></span>
    </button>
    <div class="pagination-nav-pages" style="--_pagination-nav-count: 7;">
      <div class="pagination-nav-marker-layer" aria-hidden="true">
        <div class="pagination-nav-marker" style="--_pagination-nav-marker-index: 0;"></div>
      </div>
      <ul class="pagination-nav-list" role="list">
