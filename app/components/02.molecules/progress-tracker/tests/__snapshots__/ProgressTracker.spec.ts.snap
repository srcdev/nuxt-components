// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProgressTracker > renders correct HTML structure 1`] = `
"<div class="progress-tracker">
  <div class="progress-tracker-header">
    <p class="progress-tracker-label" aria-live="polite" tabindex="-1">Step 2 of 3</p>
    <div class="progress-tracker-bar" role="progressbar" aria-valuemin="0" aria-valuemax="3" aria-valuenow="1" aria-valuetext="Step 2 of 3" style="--_progress-tracker-progress: 0.3333333333333333;"><span class="progress-tracker-bar-fill"></span></div>
  </div>
  <ol role="list" class="stepper-list has-connectors progress-tracker-list">
    <li class="stepper-list-item has-indicator indicator-top indicator-disc" style="--_connector-left: 0px; --_connector-top: 0px; --_connector-height: 0px;">
      <div class="stepper-list__indicator-custom"><span class="progress-tracker-indicator is-done" aria-hidden="true"><span class="iconify i-lucide:check progress-tracker-indicator-icon" aria-hidden="true"></span></span></div>
      <div class="stepper-list-content">
        <div class="progress-tracker-step is-done">
          <h3 id="v-0-0-step-0" class="progress-tracker-title" tabindex="-1">Create your account<span class="sr-only">, Completed</span></h3>
          <p class="progress-tracker-body">Enter your email and choose a password.</p>
          <!--v-if-->
        </div>
      </div>
    </li>
    <li class="stepper-list-item has-indicator indicator-top indicator-disc" style="--_connector-left: 0px; --_connector-top: 0px; --_connector-height: 0px;">
      <div class="stepper-list__indicator-custom"><span class="progress-tracker-indicator is-current" aria-hidden="true">2</span></div>
      <div class="stepper-list-content">
        <div class="progress-tracker-step is-current">
          <h3 id="v-0-0-step-1" class="progress-tracker-title" tabindex="-1" aria-current="step">Verify your email
            <!--v-if-->
          </h3>
          <p class="progress-tracker-body">Click the link we sent to your inbox.</p>
          <!--v-if-->
        </div>
      </div>
    </li>
    <li class="stepper-list-item has-indicator indicator-top indicator-disc">
      <div class="stepper-list__indicator-custom"><span class="progress-tracker-indicator is-upcoming" aria-hidden="true">3</span></div>
      <div class="stepper-list-content">
        <div class="progress-tracker-step is-upcoming">
          <h3 id="v-0-0-step-2" class="progress-tracker-title" tabindex="-1">Choose a plan
            <!--v-if-->
          </h3>
          <!--v-if-->
          <!--v-if-->
        </div>
      </div>
    </li>
  </ol>
</div>"
`;
