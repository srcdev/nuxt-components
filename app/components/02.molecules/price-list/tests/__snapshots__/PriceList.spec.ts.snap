// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PriceList > Snapshots > custom headings 1`] = `
"<div class="price-list">
  <div class="price-list__column">
    <h2 class="hero-text price-list__heading" data-font-size="subheading" data-axis="horizontal">
      <!--v-if--><span class="hero-text-segment">Cuts</span>
    </h2>
    <dl class="price-list__list"></dl>
  </div>
  <div class="price-list__column">
    <h2 class="hero-text price-list__heading" data-font-size="subheading" data-axis="horizontal">
      <!--v-if--><span class="hero-text-segment">Colour</span>
    </h2>
    <dl class="price-list__list"></dl>
  </div>
</div>"
`;

exports[`PriceList > Snapshots > default 1`] = `
"<div class="price-list">
  <div class="price-list__column">
    <h2 class="hero-text price-list__heading" data-font-size="subheading" data-axis="horizontal">
      <!--v-if--><span class="hero-text-segment">Cutting &amp; Treatment</span>
    </h2>
    <dl class="price-list__list">
      <div class="price-list__row">
        <dt class="price-list__description">Cut &amp; Blow Dry</dt>
        <dd class="price-list__price">
          <!--v-if--><span class="price-list__amount">£45</span>
        </dd>
      </div>
      <div class="price-list__row">
        <dt class="price-list__description">Restyle</dt>
        <dd class="price-list__price">
          <!--v-if--><span class="price-list__amount">£65</span>
        </dd>
      </div>
    </dl>
  </div>
  <div class="price-list__column">
    <h2 class="hero-text price-list__heading" data-font-size="subheading" data-axis="horizontal">
      <!--v-if--><span class="hero-text-segment">Hair Colouring</span>
    </h2>
    <dl class="price-list__list">
      <div class="price-list__row">
        <dt class="price-list__description">Full Head Colour</dt>
        <dd class="price-list__price">
          <!--v-if--><span class="price-list__amount">£75</span>
        </dd>
      </div>
      <div class="price-list__row">
        <dt class="price-list__description">Balayage</dt>
        <dd class="price-list__price">
          <!--v-if--><span class="price-list__amount">£95</span>
        </dd>
      </div>
    </dl>
  </div>
</div>"
`;
